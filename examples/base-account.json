    },
    {
     "type": "wait",
     "name": "Wait 5 minutes",
     "meta": {
      "delay": "5 minutes"
     }
    },
    {
     "type": "goto",
     "name": "Try the push again",
     "meta": {
      "targetStepName": "Push to fulfillment"
     }
    }
   ],

   "_id": "wf_n8n_gateway",
   "name": "n8n - Webhook Verification Gateway",
   "status": "published",
   "triggers": [],
   "steps": [
    {
     "type": "n8n-nodes-base.webhook",
     "name": "Receive from GHL",
     "typeVersion": 2,
     "meta": {
      "httpMethod": "POST",
      "rawBody": true
     }
    },
    {
     "type": "n8n-nodes-base.code",
     "name": "Verify X-WH-Signature",
     "typeVersion": 2,
     "meta": {
      "jsCode": "// verify the X-WH-Signature header (RSA)\nreturn items;"
     }
    },
    {
     "type": "n8n-nodes-base.httpRequest",
     "name": "Forward to the CRM",
     "typeVersion": 4,
     "meta": {
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "url": "https://services.leadconnectorhq.com/contacts/upsert"
     }
    }
   ],
   "settings": {}
  }

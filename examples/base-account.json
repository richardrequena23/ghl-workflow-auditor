    {
     "type": "inbound_webhook",
     "name": "Order webhook from the store"
    }
   ],
   "steps": [
    {
     "type": "webhook_reply",
     "name": "Reject malformed orders",
     "meta": {
      "responseCode": 500
     }
    },
    {
     "type": "create_contact",
     "name": "Create the buyer",
     "meta": {
      "email": "{{ inboundWebhookRequest.email }}",
      "phone": "{{ inboundWebhookRequest.phone }}"
     }

          "type": "contact_tag_added",
          "name": "Tagged hot-lead",
          "filters": [
            {
              "tag": "hot-lead"
            }
          ]
        }
      ],
      "steps": [
        {
          "type": "internal_notification",
          "name": "Ping the closer",
          "meta": {
            "body": "Hot lead: {{ contact.name }}"
          }
        },
        {
          "type": "add_contact_tag",
          "name": "Queue long-term nurture",
          "meta": {
            "tags": [
              "nurture-me"
            ]
          }
        }
      ],
      "settings": {}
    },
    {
      "_id": "wf_nurture",
      "name": "Long Term Nurture",
      "status": "published",
      "triggers": [
        {
          "type": "contact_tag_added",
          "name": "Tagged nurture-me",
          "filters": [
            {
              "tag": "nurture-me"
            }
          ]
        }
      ],
      "steps": [
        {
          "type": "sms",
          "name": "Check-in 1",
          "meta": {
            "body": "Been a while - still thinking about it?"
          }
        },
        {
          "type": "wait",
          "name": "Wait 30 days",
          "meta": {
            "delay": "30 days"
          }
        },
        {
          "type": "sms",
          "name": "Check-in 2",
          "meta": {
            "body": "Doors close Friday {{ contact.first_name | default: 'there' }}, want back in?"
          }
        },
        {
          "type": "add_contact_tag",
          "name": "Re-flag as hot",
          "meta": {
            "tags": [
              "hot-lead"
            ]
          }
        }
      ],
      "settings": {
        "allowReentry": true
      }
    },
    {
      "_id": "wf_welcome_sms",
      "name": "Welcome Text - New Lead",
      "status": "published",
      "triggers": [
        {
          "type": "contact_created",
          "name": "New contact",
          "filters": []
        }
      ],
      "steps": [
        {
          "type": "sms",
          "name": "Welcome text",
          "meta": {
            "fromNumber": "+1 (555) 010-8845",
            "body": "Hi {{ contact.first_name }}, thanks for reaching out about {{ contact.servcie_interest }} - grab a time here: {{ custom_values.booking_link }}"
          }
        }
      ],
      "settings": {}
    },
    {
      "_id": "wf_welcome_email",
      "name": "Welcome Email - New Lead",
      "status": "published",
      "triggers": [
        {
          "type": "contact_created",
          "name": "New contact",
          "filters": []
        }
      ],
      "steps": [
        {
          "type": "email",
          "name": "Welcome email",
          "meta": {
            "subject": "Welcome!",
            "body": "Great to have you - here is what happens next."
          }
        }
      ],
      "settings": {}
    },
    {
      "_id": "wf_speed",
      "name": "Speed to Lead - 5 Minute Response",
      "status": "published",
      "triggers": [
        {
          "type": "form_submitted",
          "name": "Intake form",
          "filters": [
            {
              "field": "formId",
              "value": "form_intake"
            }
          ]
        }
      ],
      "steps": [
        {
          "type": "sms",
          "name": "Instant reply",
          "id": "s1",
          "next": "s2",
          "meta": {
            "body": "Thanks for reaching out! When's a good time to talk? Reply STOP to opt out."
          }
        },
        {
          "type": "wait",
          "name": "Wait for their reply",
          "id": "s2",
          "next": "s3",
          "meta": {
            "waitType": "contact_reply",
            "delay": "unlimited"
          }
        },
        {
          "type": "sms",
          "name": "Second touch",
          "id": "s3",
          "next": "s4",
          "meta": {
            "body": "Still keen? Happy to find a slot."
          }
        },
        {
          "type": "email",
          "name": "Last touch",
          "id": "s4",
          "next": "s9missing",
          "meta": {
            "subject": "One more try",
            "body": "Closing your file unless I hear back."
          }
        },
        {
          "type": "sms",
          "name": "Detached follow-up",
          "id": "s7",
          "parentKey": "s6-deleted",
          "meta": {
            "body": "Orphaned when the branch above was removed."
          }
        }
      ],
      "settings": {
        "allowReentry": true
      }
    },
    {
      "_id": "wf_intake",
      "name": "Lead Intake - Qualify & Route",
      "status": "published",
      "triggers": [
        {
          "type": "contact_tag_added",
          "name": "Tagged intake",
          "filters": [
            {
              "tag": "intake"
            }
          ]
        }
      ],
      "steps": [
        {
          "type": "if_else",
          "name": "Qualified?",
          "meta": {
            "conditions": [
              {
                "field": "contact.service_interest",
                "operator": "exists"
              }
            ],
            "branches": [
              {
                "name": "Qualified",
                "actions": [
                  {
                    "type": "add_contact_tag",
                    "meta": {
                      "tags": [
                        "qualified"
                      ]
                    }
                  }
                ]
              },
              {
                "name": "None",
                "actions": []
              }
            ]
          }
        },
        {
          "type": "assign_round_robin",
          "name": "Route to a rep",
          "meta": {
            "users": []
          }
        },
        {
          "type": "book_appointment",
          "name": "Offer the strategy call",
          "meta": {
            "calendarId": "cal_deleted_2024"
          }
        },
        {
          "type": "internal_notification",
          "name": "Tell the owner",
          "meta": {
            "userId": "usr_left",
            "body": "New qualified lead."
          }
        },
        {
          "type": "webhook",
          "name": "Sync to the reporting sheet",
          "meta": {
            "url": "https://webhook.site/9d41c2aa-probe"
          }
        },
        {
          "type": "email",
          "name": "What happens next",
          "meta": {
            "subject": "Next steps",
            "body": "Here is what happens next. Book: {{ custom_values.booking_link }}"
          }
        }
      ],
      "settings": {}
    },
